# Run artifacts. These are OUTPUTS of a harness, not source — a campaign writes a trajectory, a progress
# file and a stdout log per arm, and a single battery produces hundreds. Committing them once swept 1281
# files into a source commit (R-106, 2026-08-04); this stops it recurring.
sic_games/outputs/**/campaign_trajectory*.json
sic_games/outputs/**/campaign_progress*.txt
sic_games/outputs/**/campaign_genealogy*.csv
sic_games/outputs/**/b6l_stdout*.txt
sic_games/outputs/**/b7_stdout*.txt
sic_games/outputs/**/*_results.json
sic_games/outputs/**/*_progress.txt

# Python
__pycache__/
*.py[cod]
.pytest_cache/
